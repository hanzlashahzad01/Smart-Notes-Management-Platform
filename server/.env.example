# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/noteflow

# Frontend Client URL (For CORS & Magic Links)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets
JWT_SECRET=noteflow_super_secret_jwt_key_2026_safe_secure
JWT_REFRESH_SECRET=noteflow_super_secret_refresh_jwt_key_2026_safe_secure

# Email Service (Nodemailer SMTP Configuration)
# Leave EMAIL_USER / EMAIL_PASS empty to use built-in terminal simulator in dev mode
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
